            }
          }
        },
        {
          "name": "Signup with short password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message is correct', () => pm.expect(pm.response.json().error).to.eql('Password must be 8 to 72 characters'));"
                ]
